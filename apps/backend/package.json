{
  "name": "@lumio/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --tsconfig tsconfig.json src/server.ts",
    "migrate": "tsx --tsconfig tsconfig.json src/database/migrate.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@lumio/calc-engine": "*",
    "@lumio/shared-types": "*",
    "@lumio/shared-utils": "*",
    "@lumio/validation": "*",
    "@sentry/node": "11.11.0",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "decimal.js": "10.6.0",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "mongoose": "9.12.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/mongodb": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.2",
    "testcontainers": "12.2.1"
  }
}
