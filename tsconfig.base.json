{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@lumio/shared-types": ["./packages/shared-types/src/index.ts"],
      "@lumio/shared-utils": ["./packages/shared-utils/src/index.ts"],
      "@lumio/validation": ["./packages/validation/src/index.ts"],
      "@lumio/calc-engine": ["./packages/calc-engine/src/index.ts"],
      "@lumio/backend/*": ["./apps/backend/src/*"]
    }
  }
}
