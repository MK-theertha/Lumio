# Copy to .env for running the API or worker outside Docker. Never commit real values.
# docker compose sets its own service hostnames; see docker-compose.yml.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Must be a replica set: financial operations rely on multi-document transactions.
MONGODB_URI=mongodb://localhost:27017/lumio?replicaSet=rs0&directConnection=true

# Separate Redis instances: the queue must use noeviction, the cache allkeys-lru.
REDIS_CACHE_URL=redis://localhost:6379
REDIS_QUEUE_URL=redis://localhost:6380

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173

# Number of trusted reverse proxies in front of the API (Nginx = 1).
TRUST_PROXY_HOPS=0

# Optional. Error monitoring is disabled when empty.
SENTRY_DSN=

# Required, at least 32 characters each. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Links in emails, and outgoing mail.
APP_URL=http://localhost:5173
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Lumio <no-reply@lumio.local>

# Private document storage. Leave the endpoint empty for AWS S3, or set it for an S3-compatible store.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=lumio-documents
S3_ACCESS_KEY_ID=dev-only-access-key
S3_SECRET_ACCESS_KEY=dev-only-secret-key

# ClamAV daemon. Required in staging and production; without it uploads are marked as not scanned.
CLAMAV_HOST=
CLAMAV_PORT=3310

# none, or simulated for local use. No real provider exists until one is chosen (question Q25).
EINVOICE_PROVIDER=none

# Worker health endpoint.
WORKER_HEALTH_PORT=4001

# docker compose only: override when a default host port is already in use.
# MONGO_HOST_PORT=27017
# REDIS_CACHE_HOST_PORT=6379
# REDIS_QUEUE_HOST_PORT=6380
# API_HOST_PORT=4000
# FRONTEND_HOST_PORT=5173
